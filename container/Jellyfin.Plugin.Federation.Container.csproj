<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Jellyfin.Plugin.Federation</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Federation</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dashboard page (IHasWebPages); LogicalName must match the main
         csproj so the manifest resource name is identical in both builds. -->
    <EmbeddedResource Include="../src/Web/config.html" LogicalName="Jellyfin.Plugin.Federation.Web.config.html" />
    <EmbeddedResource Include="../src/Web/status.html" LogicalName="Jellyfin.Plugin.Federation.Web.status.html" />
    <!-- Plugin logo (served by the host via meta.json "imagePath"). -->
    <None Include="../assets/logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The source-checkout target inherits Microsoft.AspNetCore.App transitively
       through the MediaBrowser.Common project reference; plain HintPath DLL
       references do not flow FrameworkReferences, so the container target needs
       this explicitly. Compile-time only — the host loads the shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The exact binaries shipped in the linuxserver/jellyfin 12.2.0 container.
         Not copied into the output: the container provides them at runtime.
         Extract from a running container, one per assembly, e.g. (linuxserver image):
           docker cp jellyfin:/usr/lib/jellyfin/bin/MediaBrowser.Controller.dll container-refs/controller.dll
           docker cp jellyfin:/usr/lib/jellyfin/bin/MediaBrowser.Model.dll container-refs/model.dll
         (see AGENTS.md, "Building for a container install") -->
    <Reference Include="MediaBrowser.Controller">
      <HintPath>../container-refs/controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>../container-refs/model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Common">
      <HintPath>../container-refs/common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jellyfin.Extensions">
      <HintPath>../container-refs/extensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jellyfin.Data">
      <HintPath>../container-refs/data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>../container-refs/Logging.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
      <HintPath>../container-refs/DependencyInjection.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- IHostedService (FederationStatusService). Ships in the image's shared
         framework; re-extract from a running container if the image is upgraded:
           docker cp jellyfin:/usr/lib/jellyfin/bin/Microsoft.Extensions.Hosting.Abstractions.dll container-refs/Hosting.Abstractions.dll -->
    <Reference Include="Microsoft.Extensions.Hosting.Abstractions">
      <HintPath>../container-refs/Hosting.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
