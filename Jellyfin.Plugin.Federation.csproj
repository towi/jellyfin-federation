<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Jellyfin.Plugin.Federation</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Federation</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../jellyfin/MediaBrowser.Controller/MediaBrowser.Controller.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../jellyfin/MediaBrowser.Model/MediaBrowser.Model.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../jellyfin/MediaBrowser.Common/MediaBrowser.Common.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../jellyfin/src/Jellyfin.Extensions/Jellyfin.Extensions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The container/ project compiles the same sources against image
         binaries: keep its generated files out of this project's glob. -->
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="container/**/*.cs" />
    <None Remove="tests/**" />
    <None Remove="container/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dashboard page (IHasWebPages). LogicalName pins the manifest name in
         both csprojs — the container project's path ("../src/...") would
         otherwise derive a different one. -->
    <EmbeddedResource Include="src/Web/config.html" LogicalName="Jellyfin.Plugin.Federation.Web.config.html" />
  </ItemGroup>
  <ItemGroup>
    <!-- Plugin logo (served by the host via meta.json "imagePath"). Deployed
         next to the DLL — see README step 3. Link flattens it to the output
         root (matching the container build) so the deploy copies one file. -->
    <None Include="assets/logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
